{
  "name": "@game/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "tsx scripts/localPostgres.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@game/engine": "workspace:*",
    "@game/protocol": "workspace:*",
    "@prisma/client": "^6",
    "argon2": "^0.45.1",
    "fastify": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@game/sim": "workspace:^",
    "@types/node": "^22.10.5",
    "embedded-postgres": "17.6.0-beta.15",
    "prisma": "^6",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
