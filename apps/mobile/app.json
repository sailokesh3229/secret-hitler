{
  "expo": {
    "name": "Secret Hitler Mobile",
    "icon": "./public/logo512.png",
    "slug": "secret-hitler-mobile",
    "scheme": "secrethitler",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/logo192.png"
    }
  }
}
