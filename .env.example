# Server
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secret_hitler
REDIS_URL=redis://localhost:6379
# Firebase Authentication (server verifies ID tokens using Google's public keys)
FIREBASE_PROJECT_ID=
# Demo guest mode only, when Firebase is unavailable. The server issues signed
# tokens; old dev:<name> tokens are never accepted by the public entry point.
ALLOW_GUEST_LOGIN=true
# Required for guest sessions to survive a restart when storage is persistent.
# Use a random string of at least 32 bytes; keep it secret.
GUEST_TOKEN_SECRET=
# Mobile (Expo) - public config, safe to expose in the app bundle
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=https://your-static-site.example
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_DEV_LOGIN=false
HOST=0.0.0.0
